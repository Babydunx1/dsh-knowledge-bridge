{
  "name": "dsh-knowledge-bridge",
  "version": "1.1.0",
  "description": "Give your DeepSeek Harness agent a brain: host-level knowledge vault access with zero-config discovery, three retrieval tools, and a guard against destructive shell commands.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "locale",
    "assets",
    "scripts",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test lib/knowledge.test.js lib/index.test.js scripts/validate-bundle.test.js",
    "demo": "node scripts/demo.mjs examples/vault",
    "validate": "node scripts/validate-bundle.js"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cordis-plugin",
    "knowledge-base",
    "knowledge-management",
    "agent-memory",
    "retrieval",
    "safety-guard",
    "sandbox",
    "multi-agent",
    "zero-dependency"
  ],
  "author": "AutoLab Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Babydunx1/dsh-knowledge-bridge.git"
  },
  "homepage": "https://github.com/Babydunx1/dsh-knowledge-bridge#readme",
  "bugs": {
    "url": "https://github.com/Babydunx1/dsh-knowledge-bridge/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
